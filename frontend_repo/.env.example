DATABASE_URL=file:./db/custom.db
NEXT_PUBLIC_CESIUM_TOKEN="your_cesium_ion_token_here"

# Esri ArcGIS Platform API Key
NEXT_PUBLIC_ARCGIS_API_KEY=""

# Groq API Key (for AI-powered flood alerts and NLP reports)
GROQ_API_KEY="your_groq_api_key_here"

# Supabase Storage — GIS data (tiles, GeoJSON, CSVs)
# When set, map data loads from Supabase CDN instead of local /public files.
# Leave blank for offline/local development.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_GIS_BUCKET="gis-data"
# Service role key — only needed for running scripts/upload_to_supabase.ts
SUPABASE_SERVICE_KEY=""

# =========================================================================
# AWS SERVERLESS & BEDROCK BACKEND (Hackathon Cloud Integration)
# =========================================================================
# Deployed Amazon API Gateway stage URL
NEXT_PUBLIC_FLOODSENSE_API_URL="https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com/prod"

# Amazon S3 Bucket for direct citizen photo evidence
NEXT_PUBLIC_AWS_S3_MEDIA_BUCKET="floodsense-media"

# AWS Region & Bedrock AI Configuration
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="anthropic.claude-3-5-haiku-20241022-v1:0"

